# Virtualenvs and caches. TabDPT and TabFM need environments of their own.
venv-*/
__pycache__/
*.pyc
.cache/
scikit_learn_data/
tmp/

# Model weights are never in the repository; TabFM's 6.6 GB come from run/download_tabfm.sh.
*.safetensors
*.ckpt
*.pt
*.bin

# Console logs. A measurement is its CSV; a log that is itself evidence is added with
# `git add -f` and a `!name.log` line below.
*.log

# Only CSVs that a finding cites or a script reads are kept (rule 3); the rest is local.
archive/

# Generated supplement files; keep the note, its source and instructions.
/output/
/supplement/*
!/supplement/README.md
!/supplement/jaric_extreme_context_targets.tex
!/supplement/jaric_extreme_context_targets.pdf

# Working files, including the locks and temporary files of common/files.py.
*.tmp
*.bak
*.lock
.DS_Store
Thumbs.db

# Notebook checkpoints and build output
.ipynb_checkpoints/
*.egg-info/
build/
dist/
