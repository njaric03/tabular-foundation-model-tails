# Text is stored with LF; without this git on Windows warns about CRLF on every diff.
* text=auto eol=lf

# sh and bash break on a CRLF in the shebang line
*.sh text eol=lf

# Binary, never converted
*.doc   binary
*.docx  binary
*.ckpt  binary
*.pt    binary
*.safetensors binary

# Result CSVs: a line diff is useful, a merge is not
*.csv text eol=lf -merge

# Notebooks: outputs do not merge
*.ipynb text eol=lf -merge linguist-documentation
